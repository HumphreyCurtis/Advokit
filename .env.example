# Copy to .env.local and fill in. Used by both the Next.js app and analysis/app.py.

# OpenAI API key — powers the Benefit Buddy chatbot (app/api/chatbot/route.ts)
OPENAI_API_KEY=

# MongoDB connection string — stores chat logs and feedback
MONGODB_URI=

# MongoDB database name (defaults to "advokit" if unset)
MONGODB_DB=advokit
